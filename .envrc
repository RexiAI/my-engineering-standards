# direnv — load the spec-pipeline model config and agent credentials into the
# shell whenever you cd into this repo.
#
# Both loaders resolve their repo root from their own location, so they work
# from any cwd. Precedence is unchanged from the shell-profile mechanism
# (no-clobber: a value already exported in the environment still wins).
#
# One-time per-machine setup:
#   eval "$(direnv hook bash)"          # or: eval "$(direnv hook zsh)"
#   direnv allow                        # trust this file the first time
#
# Model vars (8 SPEC_*_MODEL):  scripts/load-model-env.sh
#   committed defaults        config/model.local.env.example
#   per-machine override      config/model.local.env       (gitignored)
# Agent credentials:          scripts/load-env.sh
#   per-machine file          config/agent.local.env       (gitignored)
#
# --emit: run the loaders in a clean subshell and eval their export lines.
# Sourcing the loaders directly here is unsafe — their "leave no trace" unsets
# collide with direnv's shell state. `bash <script>` runs them without needing
# the +x bit (they are source-oriented scripts).
eval "$(bash scripts/load-model-env.sh --emit)"
eval "$(bash scripts/load-env.sh --emit)"
