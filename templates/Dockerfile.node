# NestJS backend only — for Next.js frontends see templates/Dockerfile.next
# ARG NODE_VERSION lets CI or a local build pass --build-arg NODE_VERSION=$(cat .nvmrc)
# so the image always matches .nvmrc instead of drifting from a hardcoded tag here.
ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-alpine AS build
WORKDIR /app
COPY package*.json tsconfig*.json nest-cli.json ./
RUN npm ci
COPY . .
RUN npm run build && npm prune --production

FROM node:${NODE_VERSION}-alpine
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./
USER appuser
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1
CMD ["node", "dist/main"]
