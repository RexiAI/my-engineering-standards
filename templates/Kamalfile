# frozen_string_literal: true

# Default Kamal configuration for child projects.
# Generated by scripts/init-deploy.sh — copy to .kamal/config.rb and customize.
# See docs/DEPLOYMENT.md §Kamal + VPS for the full guide.

service = ENV.fetch("SERVICE_NAME", "my-service")
registry_image = ENV.fetch("KAMAL_IMAGE", "ghcr.io/%s/%s" % [
  ENV.fetch("GITHUB_REPOSITORY", "org/repo"),
  service,
])

# ── Host config ──────────────────────────────────────────────────────────────
# All host fields come from CI secrets/env. No hardcoding.
host = ENV.fetch("SSH_HOST", "127.0.0.1")
port = ENV.fetch("SSH_PORT", "22").to_i
user = ENV.fetch("SSH_USER", "root")
ssh_key = ENV.fetch("SSH_PRIVATE_KEY", "")

# ── Base config ──────────────────────────────────────────────────────────────
set :service, service
set :image, registry_image
set :ssh, { host: host, port: port, user: user, key: ssh_key }
set :ssh_arguments, "-o StrictHostKeyChecking=accept-new"

# Traefik reverse proxy (auto-started by Kamal).
# Override the domain in your service's labels or via APP_DOMAIN env.
set :primary_target_host, host
set :primary_target_port, port

# ── Traefik labels ───────────────────────────────────────────────────────────
app_domain = ENV.fetch("APP_DOMAIN", "#{service}.example.com")
set :labels, {
  "traefik.enable" => "true",
  "traefik.http.routers.#{service}-http.rule" => "Host(`#{app_domain}`)",
  "traefik.http.routers.#{service}-http.entrypoints" => "web",
  "traefik.http.routers.#{service}-http.middlewares" => "redirect-to-https",
  "traefik.http.middlewares.redirect-to-https.redirectscheme.scheme" => "https",
  "traefik.http.routers.#{service}-https.rule" => "Host(`#{app_domain}`)",
  "traefik.http.routers.#{service}-https.entrypoints" => "websecure",
  "traefik.http.routers.#{service}-https.tls" => "true",
  "traefik.http.routers.#{service}-https.tls.certresolver" => "letsencrypt",
}

# ── Healthcheck ──────────────────────────────────────────────────────────────
# Default assumes a /health endpoint on SERVICE_PORT (default 8080).
# Spring Boot uses /actuator/health — override via KAMAL_HEALTH_URL if needed.
health_url = ENV.fetch("KAMAL_HEALTH_URL", nil)
if health_url
  set :health_check, url: health_url, interval: 30, timeout: 5, max_checks: 30
else
  service_port = ENV.fetch("SERVICE_PORT", "8080")
  set :health_check, url: "http://#{service}:#{service_port}/health",
                      interval: 30, timeout: 5, max_checks: 30
end

# ── Environment variables ────────────────────────────────────────────────────
# Non-secret runtime config from env. Secrets must be passed separately
# (see docs/DEPLOYMENT.md §Secrets Management).
base_env = {
  RAILS_ENV: "production",
  SERVICE_NAME: service,
  LOG_LEVEL: ENV.fetch("LOG_LEVEL", "info"),
}

# Merge any extra env vars passed through from CI.
# CI scripts can set these as KAMAL_ENV_* to forward arbitrary vars.
ENV.each do |key, value|
  if key.start_with?("KAMAL_ENV_")
    env_key = key.sub(/^KAMAL_ENV_/, "").to_sym
    base_env[env_key] = value
  end
end

set :env, base_env

# ── Pre-deploy hook ──────────────────────────────────────────────────────────
# Run migrations or other setup before deploy.
# Defaults to "true" (no-op) if KAMAL_PRE_DEPLOY is unset.
set :pre-deploy-command, ENV.fetch("KAMAL_PRE_DEPLOY", "true")

# ── Docker options ───────────────────────────────────────────────────────────
set :docker_options, "-d --restart unless-stopped"

# ── Persistent volumes ───────────────────────────────────────────────────────
# Uncomment and customize for services that need persistent state.
# set :volumes, [
#   "/var/lib/#{service}:#{service}",
# ]