FROM amazoncorretto:21 AS build
WORKDIR /app
COPY target/*.jar app.jar
RUN java -Djarmode=layertools -jar app.jar extract

FROM amazoncorretto:21
RUN dnf -y install openssl ca-certificates curl shadow-utils && dnf clean all
WORKDIR /app
COPY --from=build app/dependencies/ ./
COPY --from=build app/spring-boot-loader/ ./
COPY --from=build app/snapshot-dependencies/ ./
COPY --from=build app/application/ ./
RUN useradd --system --user-group --no-create-home appuser
USER appuser
EXPOSE 8080
# Requires management.endpoints.web.exposure.include=health (or equivalent YAML) in the child app.
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s \
  CMD curl -f http://localhost:8080/actuator/health || exit 1
ENTRYPOINT ["java", "org.springframework.boot.loader.launch.JarLauncher"]
