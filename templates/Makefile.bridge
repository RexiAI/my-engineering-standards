# Makefile Bridge Template
# Copy this to your child repo root as `Makefile`
# Then run: make init-ai

.PHONY: init-ai init-standards session-check session-end hooks-install help

help:
	@echo "Available targets:"
	@echo "  init-ai         Symlink AGENTS.md and copy opencode.json from .standards/"
	@echo "                  Add COPY_AGENTS=1 to copy spec-pipeline agents/commands as"
	@echo "                  real files instead of symlinking (e.g. to set a per-agent"
	@echo "                  model override without editing files inside .standards/)."
	@echo "  init-standards  Initialize .standards/ submodule"
	@echo "  hooks-install   Wire .githooks/pre-commit (guard-env) via core.hooksPath"
	@echo "  session-check   Run session start health check"
	@echo "  session-end     Run session end check (pre-commit verification)"

init-standards:
	@if [ ! -d ".standards" ]; then \
		echo "Adding standards submodule..."; \
		git submodule add git@github.com:RexiAI/my-engineering-standards.git .standards; \
	else \
		echo ".standards/ already exists. Run 'make init-ai' to set up the bridge."; \
	fi

init-ai:
	@echo "Setting up AI rules bridge from .standards/..."

	# Symlink AGENTS.md so OpenCode auto-discovers it
	@if [ ! -f "AGENTS.md" ]; then \
		ln -sf .standards/AGENTS.md AGENTS.md; \
		echo "  [SYMLINK] .standards/AGENTS.md -> AGENTS.md"; \
	elif [ ! -L "AGENTS.md" ]; then \
		echo "  [SKIP] AGENTS.md exists and is not a symlink (manual backup required)"; \
	else \
		ln -sf .standards/AGENTS.md AGENTS.md; \
		echo "  [UPDATE] .standards/AGENTS.md -> AGENTS.md"; \
	fi

	# Copy opencode.json bridge if not already present
	@if [ ! -f "opencode.json" ]; then \
		cp .standards/templates/opencode.json.bridge opencode.json; \
		echo "  [COPY] opencode.json.bridge -> opencode.json"; \
	else \
		echo "  [SKIP] opencode.json already exists"; \
	fi

	# Symlink OKF (Operational Knowledge Framework)
	@if [ ! -d "okf" ]; then \
		ln -sf .standards/okf okf; \
		echo "  [SYMLINK] .standards/okf -> okf"; \
	else \
		echo "  [SKIP] okf/ already exists"; \
	fi

	# Symlink (default) or copy (COPY_AGENTS=1) spec pipeline agents + commands
	# (see docs/SPEC_PIPELINE.md)
	@mkdir -p .opencode
ifeq ($(COPY_AGENTS),1)
	@if [ -L ".opencode/agents" ]; then \
		echo "  [SKIP] .opencode/agents is a symlink — remove it first if you want a real copy"; \
	elif [ -e ".opencode/agents" ]; then \
		echo "  [SKIP] .opencode/agents already exists as a real directory — not overwriting"; \
	else \
		cp -r .standards/agents .opencode/agents; \
		echo "  [COPY] .standards/agents -> .opencode/agents (you own these now)"; \
	fi
	@if [ -L ".opencode/commands" ]; then \
		echo "  [SKIP] .opencode/commands is a symlink — remove it first if you want a real copy"; \
	elif [ -e ".opencode/commands" ]; then \
		echo "  [SKIP] .opencode/commands already exists as a real directory — not overwriting"; \
	else \
		cp -r .standards/commands .opencode/commands; \
		echo "  [COPY] .standards/commands -> .opencode/commands (you own these now)"; \
	fi
else
	@if [ ! -e ".opencode/agents" ]; then \
		ln -sf ../.standards/agents .opencode/agents; \
		echo "  [SYMLINK] .standards/agents -> .opencode/agents"; \
	else \
		echo "  [SKIP] .opencode/agents already exists"; \
	fi
	@if [ ! -e ".opencode/commands" ]; then \
		ln -sf ../.standards/commands .opencode/commands; \
		echo "  [SYMLINK] .standards/commands -> .opencode/commands"; \
	else \
		echo "  [SKIP] .opencode/commands already exists"; \
	fi
endif

	# Copy language-specific configs if project type is detected
	@if [ -f "pom.xml" ]; then \
		echo "  [JAVA] Detected Maven project"; \
		cp -n .standards/language-specific/java/*.xml . 2>/dev/null || true; \
	elif ls *.go 2>/dev/null | head -1 > /dev/null 2>&1; then \
		echo "  [GO] Detected Go project"; \
		if [ ! -f ".golangci.yml" ]; then cp .standards/language-specific/go/golangci.yml .golangci.yml 2>/dev/null || true; fi; \
	elif [ -f "package.json" ]; then \
		echo "  [JS/TS] Detected Node.js project"; \
		[ ! -f ".eslintrc.js" ] && [ ! -f "eslint.config.js" ] && cp -n .standards/language-specific/javascript/eslint.config.js . 2>/dev/null || true; \
		[ ! -f ".prettierrc.js" ] && [ ! -f "prettier.config.js" ] && cp -n .standards/language-specific/javascript/prettier.config.js . 2>/dev/null || true; \
	fi

	# Copy session hygiene scripts if not already present
	@if [ ! -f "session-start-check.sh" ]; then \
		cp .standards/templates/session-start-check.sh session-start-check.sh; \
		chmod +x session-start-check.sh; \
		echo "  [COPY] templates/session-start-check.sh -> session-start-check.sh"; \
	else \
		echo "  [SKIP] session-start-check.sh already exists"; \
	fi
	@if [ ! -f "session-end-check.sh" ]; then \
		cp .standards/templates/session-end-check.sh session-end-check.sh; \
		chmod +x session-end-check.sh; \
		echo "  [COPY] templates/session-end-check.sh -> session-end-check.sh"; \
	else \
		echo "  [SKIP] session-end-check.sh already exists"; \
	fi

	@echo ""
	@echo "Done! AGENTS.md is now linked to .standards/."
	@echo "OpenCode will auto-discover AGENTS.md and load instructions from .standards/"
	@$(MAKE) --no-print-directory hooks-install

hooks-install:
	@mkdir -p .githooks
	@if [ ! -f ".githooks/pre-commit" ]; then \
		cp .standards/templates/githooks-pre-commit .githooks/pre-commit; \
		chmod +x .githooks/pre-commit; \
		echo "  [COPY] templates/githooks-pre-commit -> .githooks/pre-commit"; \
	else \
		echo "  [SKIP] .githooks/pre-commit already exists"; \
	fi
	@git config core.hooksPath .githooks && echo "  [CONFIG] core.hooksPath = .githooks"

session-check:
	@if [ -f "session-start-check.sh" ]; then \
		bash session-start-check.sh; \
	else \
		echo "session-start-check.sh not found. Run 'make init-ai' first."; \
		exit 1; \
	fi

session-end:
	@if [ -f "session-end-check.sh" ]; then \
		bash session-end-check.sh; \
	else \
		echo "session-end-check.sh not found. Run 'make init-ai' first."; \
		exit 1; \
	fi
