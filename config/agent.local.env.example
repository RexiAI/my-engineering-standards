# Per-machine credentials for this repo's pipeline agents (spec 013).
#
# The pipeline agents consume exactly two GitHub credentials per machine. This
# template enumerates those two — nothing invented. ONE-TIME SETUP:
#   1. Copy this file to config/agent.local.env and fill in real values:
#        cp config/agent.local.env.example config/agent.local.env
#   2. Source the loader in the shell where /spec and /build run:
#        source scripts/load-env.sh      # PowerShell: scripts/load-env.ps1
#   3. NEVER commit config/agent.local.env — scripts/guard-env.sh and the
#      .gitignore rule make that structural (self-ci enforces both).

# GITHUB_TOKEN — personal access token for the GitHub MCP server
# (okf/mcp-server-connection.md) and PR diagnostic comments (docs/TESTING.md).
# Create a fine-grained PAT with repo scope at
# https://github.com/settings/personal-access-tokens.
GITHUB_TOKEN=<your-github-personal-access-token>

# GH_TOKEN — gh CLI / release-automation credential (docs/CI_CD.md §Release
# Process); the spec PR Opener uses it to push the spec branch and open the
# draft PR. Create a classic PAT (or reuse the fine-grained token above).
GH_TOKEN=<your-github-personal-access-token>
