# Per-machine model configuration for this repo's spec pipeline agents.
#
# opencode.json resolves every agent.*.model from an {env:SPEC_*_MODEL}
# reference. This file carries PLACEHOLDER values; the repo-root .envrc (a
# gitignored per-machine copy of templates/.envrc.example) loads it first via
# dotenv_if_exists, so every var is non-empty when opencode launches — but the
# placeholders are not runnable ids until you override them per machine.
#
# ONE-TIME SETUP (direnv):
#   1. Install direnv and wire the hook once in your shell profile:
#        eval "$(direnv hook bash)"
#   2. Copy the template and allow it:
#        cp templates/.envrc.example .envrc
#        direnv allow
#   3. To make the pipeline runnable, copy this file to
#      config/model.local.env, fill in real model ids, then restart opencode
#      (config is read once at startup). NEVER commit config/model.local.env —
#      it is gitignored.
#
# Precedence: the .envrc's dotenv_if_exists lines run in order, each clobbering
# earlier values — placeholders here, then config/model.local.env, then
# config/agent.local.env. See docs/SPEC_PIPELINE.md §Model configuration.
#
# The values below are PLACEHOLDERS, not a working default. No provider or
# model is assumed by this repo: put real <provider>/<model> ids in your
# gitignored config/model.local.env before running /spec or /build, or the
# pipeline resolves to ids that do not exist and every stage fails to start.
# Two tiers are used: your-plus-model for the high-judgment seats
# (specifier, ux, verifier, mutation-runner, pr-review) and your-fast-model
# for the bounded/mechanical seats (pr-opener, deployer, coder, refactorer,
# pipeline).

# spec-specifier: pipeline specifier stage — committed placeholder until overridden locally
SPEC_SPECIFIER_MODEL=your-provider/your-plus-model

# spec-ux: UX Designer stage — committed placeholder until overridden locally
SPEC_UX_MODEL=your-provider/your-plus-model

# spec-verifier: independent re-check stage — committed placeholder until overridden locally
SPEC_VERIFIER_MODEL=your-provider/your-plus-model

# spec-mutation-runner: mutation-testing gate — committed placeholder until overridden locally
SPEC_MUTATION_RUNNER_MODEL=your-provider/your-plus-model

# spec-pr-opener: commits, pushes, opens the draft PR — committed placeholder until overridden locally
SPEC_PR_OPENER_MODEL=your-provider/your-fast-model

# spec-deployer: stage 5c deploy verification — mechanical wait/verify record, flash for the mechanical stage
SPEC_DEPLOYER_MODEL=your-provider/your-fast-model

# spec-coder: implementation stage — committed placeholder until overridden locally
SPEC_CODER_MODEL=your-provider/your-fast-model

# spec-refactorer: structure-only pass — committed placeholder until overridden locally
SPEC_REFACTORER_MODEL=your-provider/your-fast-model

# spec-pipeline: orchestrator (/spec, /build) — committed placeholder until overridden locally
SPEC_PIPELINE_MODEL=your-provider/your-fast-model

# pr-review: headless CI review agent (spec 024) — committed placeholder until overridden locally
SPEC_PR_REVIEW_MODEL=your-provider/your-plus-model

# ── Typed-judgment layer (spec 028, ADR 0004) ────────────────────────────────
# Opt-in configuration for scripts/typed-judgment.sh. Everything below is
# commented out by default: with these unset the script exits 10 (fallback)
# and every consumer runs its stock procedure unchanged. Fill in real values
# in your gitignored config/model.local.env only — never here.
# JUDGMENT_API_URL=https://<your-judgment-api-host>/<path>
# JUDGMENT_MODEL=<provider/model-id>
# JUDGMENT_MIN_CONFIDENCE=0.6
# JUDGMENT_DAILY_CAP=200
# Serialized-state payload cap in bytes (spec 034). The wrapper truncates an
# over-cap state deterministically (head + marker + tail) before sending and
# records reason=payload_overflow. Default 12288 = 12 KB; the measured local
# backend failure threshold was 20548 bytes for a JSON-shaped state.
# JUDGMENT_MAX_STATE_BYTES=12288
#
# ── Local judgment backend (spec 029, ADR 0005) ──────────────────────────────
# Backend switch: valid values 'local' | 'hosted'; unset or empty = default
# hosted (the spec 028 paid-API behavior, byte-identical). local points the
# wrapper at a judgment backend you serve yourself — scripts/judgment-local-up.sh
# up prints the exact lines below once the server is healthy. In local mode the
# API key is OPTIONAL (see config/agent.local.env.example) and JUDGMENT_MODEL
# is optional too: unset sends the backend's default alias.
# JUDGMENT_BACKEND=local
# Local backend URL example — port and path from the winning recipe
# (spec 029 spike report §Serving recipe; start it with `make judgment-up`):
# JUDGMENT_API_URL=http://localhost:8009/v1/systemone
# Recalibrated confidence threshold for the local backend. Method: 5th
# percentile of correct-answer confidence measured on the spike fixture set
# (spec 029 spike report §Recommended confidence threshold). Use this value
# with JUDGMENT_BACKEND=local; keep 0.6 above for hosted.
# JUDGMENT_MIN_CONFIDENCE=0.28

