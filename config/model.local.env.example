# Per-machine model configuration for this repo's spec pipeline agents.
#
# opencode.json resolves every agent.*.model from an {env:SPEC_*_MODEL}
# reference. This file carries the committed default values; the loader
# (scripts/load-model-env.sh) falls back to it whenever a var is not already
# exported and no local override exists.
#
# ONE-TIME SETUP:
#   1. Wire the loader into your shell profile once, so every shell exports
#      these vars automatically before opencode launches:
#        echo 'source <repo>/scripts/load-model-env.sh' >> ~/.bashrc   # or ~/.zshrc
#      The loader is never sourced per-launch by hand — the profile wiring is
#      the mechanism.
#   2. Only if you want to override a committed default: copy this file to
#      config/model.local.env, fill in real model ids, then restart opencode
#      (config is read once at startup). NEVER commit config/model.local.env —
#      it is gitignored.
#
# Precedence (per var): already-exported env var > config/model.local.env >
# this example (committed defaults). See docs/SPEC_PIPELINE.md §Model
# configuration for the full mechanism.
#
# ZEN PROVIDER (optional): to route an agent through OpenCode Zen instead of
# OpenCode Go, uncomment the opencode-zen/ line for that agent and set the
# OPENCODE_API_KEY in your shell profile (from https://opencode.ai/zen/v1).
# The Zen model id used here is kimi-k3 (Kimi K3). Never put the key in this
# file — it is committed; the key belongs in your profile or .env.
#   e.g.  SPEC_VERIFIER_MODEL=opencode-zen/kimi-k3
#         export OPENCODE_API_KEY=sk-zen-...
# See docs/SPEC_PIPELINE.md §Using OpenCode Zen.

# spec-specifier: pipeline specifier stage — committed default until overridden locally
SPEC_SPECIFIER_MODEL=opencode-go/deepseek-v4-flash
# SPEC_SPECIFIER_MODEL=opencode-zen/kimi-k3

# spec-ux: UX Designer stage — committed default until overridden locally
SPEC_UX_MODEL=opencode-go/deepseek-v4-flash
# SPEC_UX_MODEL=opencode-zen/kimi-k3

# spec-verifier: independent re-check stage — committed default until overridden locally
SPEC_VERIFIER_MODEL=opencode-go/qwen3.7-plus
# SPEC_VERIFIER_MODEL=opencode-zen/kimi-k3

# spec-mutation-runner: mutation-testing gate — committed default until overridden locally
SPEC_MUTATION_RUNNER_MODEL=opencode-go/qwen3.7-plus
# SPEC_MUTATION_RUNNER_MODEL=opencode-zen/kimi-k3

# spec-pr-opener: commits, pushes, opens the draft PR — committed default until overridden locally
SPEC_PR_OPENER_MODEL=opencode-go/qwen3.7-plus
# SPEC_PR_OPENER_MODEL=opencode-zen/kimi-k3

# spec-coder: implementation stage — committed default until overridden locally
SPEC_CODER_MODEL=opencode-go/deepseek-v4-flash
# SPEC_CODER_MODEL=opencode-zen/kimi-k3

# spec-refactorer: structure-only pass — committed default until overridden locally
SPEC_REFACTORER_MODEL=opencode-go/deepseek-v4-flash
# SPEC_REFACTORER_MODEL=opencode-zen/kimi-k3

# spec-pipeline: orchestrator (/spec, /build) — committed default until overridden locally
SPEC_PIPELINE_MODEL=opencode-go/deepseek-v4-flash
# SPEC_PIPELINE_MODEL=opencode-zen/kimi-k3
