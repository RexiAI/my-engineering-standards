# Per-machine model configuration for this repo's spec pipeline agents.
#
# opencode.json resolves every agent.*.model from an {env:SPEC_*_MODEL}
# reference. This file carries the committed DEFAULT values; the repo-root
# .envrc (a gitignored per-machine copy of templates/.envrc.example) loads it
# first via dotenv_if_exists, so every var is non-empty when opencode launches.
#
# ONE-TIME SETUP (direnv):
#   1. Install direnv and wire the hook once in your shell profile:
#        eval "$(direnv hook bash)"
#   2. Copy the template and allow it:
#        cp templates/.envrc.example .envrc
#        direnv allow
#   3. Only if you want to override a committed default: copy this file to
#      config/model.local.env, fill in real model ids, then restart opencode
#      (config is read once at startup). NEVER commit config/model.local.env —
#      it is gitignored.
#
# Precedence: the .envrc's dotenv_if_exists lines run in order, each clobbering
# earlier values — committed defaults here, then config/model.local.env, then
# config/agent.local.env. See docs/SPEC_PIPELINE.md §Model configuration.

# spec-specifier: pipeline specifier stage — committed default until overridden locally
SPEC_SPECIFIER_MODEL=bailian-token-plan-personal/qwen3.8-max

# spec-ux: UX Designer stage — committed default until overridden locally
SPEC_UX_MODEL=bailian-token-plan-personal/qwen3.8-max

# spec-verifier: independent re-check stage — committed default until overridden locally
SPEC_VERIFIER_MODEL=bailian-token-plan-personal/qwen3.8-max

# spec-mutation-runner: mutation-testing gate — committed default until overridden locally
SPEC_MUTATION_RUNNER_MODEL=bailian-token-plan-personal/qwen3.8-max

# spec-pr-opener: commits, pushes, opens the draft PR — committed default until overridden locally
SPEC_PR_OPENER_MODEL=bailian-token-plan-personal/qwen3.8-flash

# spec-coder: implementation stage — committed default until overridden locally
SPEC_CODER_MODEL=bailian-token-plan-personal/qwen3.8-flash

# spec-refactorer: structure-only pass — committed default until overridden locally
SPEC_REFACTORER_MODEL=bailian-token-plan-personal/qwen3.8-flash

# spec-pipeline: orchestrator (/spec, /build) — committed default until overridden locally
SPEC_PIPELINE_MODEL=bailian-token-plan-personal/qwen3.8-flash

# pr-review: headless CI review agent (spec 024) — committed default until overridden locally
SPEC_PR_REVIEW_MODEL=bailian-token-plan-personal/qwen3.8-max

# ── Typed-judgment layer (spec 028, ADR 0004) ────────────────────────────────
# Opt-in configuration for scripts/typed-judgment.sh. Everything below is
# commented out by default: with these unset the script exits 10 (fallback)
# and every consumer runs its stock procedure unchanged. Fill in real values
# in your gitignored config/model.local.env only — never here.
# JUDGMENT_API_URL=https://<your-judgment-api-host>/<path>
# JUDGMENT_MODEL=<provider/model-id>
# JUDGMENT_MIN_CONFIDENCE=0.6
# JUDGMENT_DAILY_CAP=200

