#!/usr/bin/env bats
# pr-size-gate.bats — acceptance tests for spec 045 Tasks 2-3
# (specs/045-pr-size-gate-and-auto-merge/20-acceptance/AC-045-02-*.md,
# AC-045-03-*.md). Contract: changed lines = additions + deletions after the
# exclusion classes, tier 200/400, and the override label authorizes only a
# CODEOWNER on a >400 PR.

load test_helper
bats_require_minimum_version 1.5.0

GATE="$REPO_ROOT/scripts/pr-size-gate.sh"

setup() { setup_tmpdir; }
teardown() { teardown_tmpdir; }

# MODIFIED_DIFF — a realistic unified diff with no exclusion marker, no added
# generated-code marker, and no deleted-file section.
MODIFIED_DIFF='diff --git a/src/a.ts b/src/a.ts
--- a/src/a.ts
+++ b/src/a.ts
@@ -1,2 +1,2 @@
-old line
+new line'

# deleted_diff <path> — a section that marks <path> as a pure deletion.
deleted_diff() { # <path> → unified diff marking a deleted file
  printf 'diff --git a/%s b/%s\ndeleted file mode 100644\nindex 1111111..0000000\n--- a/%s\n+++ /dev/null\n@@ -1,3 +0,0 @@\n-old\n' \
    "$1" "$1" "$1"
}

# modified_diff <path> — a section that modifies <path> in place (not deleted).
modified_diff() { # <path> → unified diff modifying a still-present file
  printf 'diff --git a/%s b/%s\n--- a/%s\n+++ b/%s\n@@ -1,2 +1,1 @@\n-old\n-old2\n' \
    "$1" "$1" "$1" "$1"
}

# fixture <numstat-body> <diff-body> — writes both inputs, sets NS/DF globals.
fixture() { # <numstat> <diff> → sets $NS $DF
  NS="$TMPDIR_HELPER/numstat.txt"
  DF="$TMPDIR_HELPER/pr.diff"
  printf '%s\n' "$1" > "$NS"
  printf '%s\n' "$2" > "$DF"
}

# gate [args...] — run the size gate on the current fixture plus extra args.
gate() { run bash "$GATE" --numstat-file "$NS" --diff-file "$DF" "$@"; }

# exactly_one <key> — 0 when stdout carries exactly one `key=` line.
exactly_one() { [ "$(grep -c "^$1=" <<< "$output")" -eq 1 ]; }

# ── AC-045-02: changed-line accounting and exclusions ────────────────────────

@test "AC-045-02-01 — additions and deletions are summed" {
  fixture "$(printf '12\t8\tsrc/a.ts\n3\t1\tsrc/b.ts')" "$MODIFIED_DIFF"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"changed=24"* ]]
  [[ "$output" == *"excluded=0"* ]]
}

@test "AC-045-02-02 — lockfiles are excluded" {
  fixture "$(printf '500\t500\tpackage-lock.json\n2\t1\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"changed=3"* ]]
  [[ "$output" == *"excluded=1"* ]]
}

@test "AC-045-02-03 — generated code is excluded by path" {
  fixture "$(printf '40\t10\tsrc/generated/client.ts\n1\t1\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"changed=2"* ]]
  [[ "$output" == *"excluded=1"* ]]
}

@test "AC-045-02-04 — generated code is excluded by content marker" {
  fixture "$(printf '90\t0\tlib/api.go\n2\t2\tsrc/a.ts')" \
    'diff --git a/lib/api.go b/lib/api.go
--- a/lib/api.go
+++ b/lib/api.go
@@ -0,0 +1,2 @@
+// Code generated by protoc-gen-go. DO NOT EDIT.
+package api'
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"changed=4"* ]]
  [[ "$output" == *"excluded=1"* ]]
}

@test "AC-045-02-05 — snapshot files are excluded" {
  fixture "$(printf '10\t10\t__snapshots__/a.test.ts.snap\n5\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"changed=5"* ]]
  [[ "$output" == *"excluded=1"* ]]
}

@test "AC-045-02-06 — a pure file deletion is excluded" {
  fixture "$(printf '0\t700\told/legacy.ts\n4\t2\tsrc/a.ts')" "$(deleted_diff old/legacy.ts)"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"changed=6"* ]]
  [[ "$output" == *"excluded=1"* ]]
}

@test "AC-045-02-07 — a file that only lost lines still counts" {
  fixture "$(printf '0\t50\tsrc/still-here.ts\n2\t0\tsrc/a.ts')" "$(modified_diff src/still-here.ts)"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"changed=52"* ]]
  [[ "$output" == *"excluded=0"* ]]
}

@test "AC-045-02-08 — binary entries contribute zero" {
  fixture "$(printf -- '-\t-\tassets/logo.png\n2\t0\tREADME.md')" "$MODIFIED_DIFF"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"changed=2"* ]]
}

@test "AC-045-02-09 — a rename is counted once" {
  fixture "$(printf '4\t2\tsrc/{old => new}/file.ts')" "$MODIFIED_DIFF"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"changed=6"* ]]
  [[ "$output" == *"excluded=0"* ]]
}

@test "AC-045-02-10 — an empty diff counts zero" {
  fixture "$(printf '')" "$(printf '')"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"changed=0"* ]]
  [[ "$output" == *"excluded=0"* ]]
}

# ── AC-045-03: tiers, override label, exit contract ─────────────────────────

@test "AC-045-03-01 — exactly 200 lines is the auto-merge tier" {
  fixture "$(printf '200\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"tier=auto"* ]]
  [[ "$output" == *"automerge=true"* ]]
}

@test "AC-045-03-02 — 201 lines requires a human" {
  fixture "$(printf '201\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"tier=human"* ]]
  [[ "$output" == *"automerge=false"* ]]
}

@test "AC-045-03-03 — exactly 400 lines still requires a human" {
  fixture "$(printf '400\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"tier=human"* ]]
  [[ "$output" == *"automerge=false"* ]]
}

@test "AC-045-03-04 — 401 lines fails the check" {
  fixture "$(printf '401\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate
  [ "$status" -eq 1 ]
  [[ "$output" == *"tier=blocked"* ]]
  [[ "$output" == *"automerge=false"* ]]
}

@test "AC-045-03-05 — zero changed lines is the auto-merge tier" {
  fixture "$(printf '')" "$(printf '')"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"tier=auto"* ]]
  [[ "$output" == *"automerge=true"* ]]
}

@test "AC-045-03-06 — override label is ignored below the 400 threshold" {
  CO="$TMPDIR_HELPER/CODEOWNERS"
  printf '* @alice\n' > "$CO"
  fixture "$(printf '200\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate --label present --label-actor alice --codeowners "$CO"
  [ "$status" -eq 0 ]
  [[ "$output" == *"tier=auto"* ]]
  [[ "$output" == *"override=ignored"* ]]
  [[ "$output" == *"automerge=true"* ]]
}

@test "AC-045-03-07 — 401 lines without the label is blocked" {
  fixture "$(printf '401\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate --label absent
  [ "$status" -eq 1 ]
  [[ "$output" == *"override=absent"* ]]
  [[ "$output" == *"tier=blocked"* ]]
}

@test "AC-045-03-08 — an authorized override passes but never auto-merges" {
  CO="$TMPDIR_HELPER/CODEOWNERS"
  printf '* @alice\n' > "$CO"
  fixture "$(printf '401\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate --label present --label-actor alice --codeowners "$CO"
  [ "$status" -eq 0 ]
  [[ "$output" == *"tier=override"* ]]
  [[ "$output" == *"override=authorized"* ]]
  [[ "$output" == *"automerge=false"* ]]
}

@test "AC-045-03-09 — an unauthorized override does not pass" {
  CO="$TMPDIR_HELPER/CODEOWNERS"
  printf '* @alice\n' > "$CO"
  fixture "$(printf '401\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate --label present --label-actor mallory --codeowners "$CO"
  [ "$status" -eq 1 ]
  [[ "$output" == *"tier=blocked"* ]]
  [[ "$output" == *"override=unauthorized"* ]]
}

@test "AC-045-03-10 — no CODEOWNERS file falls back to the repo owner" {
  fixture "$(printf '401\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate --label present --label-actor carol --repo-owner carol \
    --codeowners "$TMPDIR_HELPER/absent/CODEOWNERS"
  [ "$status" -eq 0 ]
  [[ "$output" == *"tier=override"* ]]
  [[ "$output" == *"override=authorized"* ]]
}

# ── Unit: usage/input errors and output contract ────────────────────────────

@test "size gate: missing inputs is a usage error, never a pass" {
  run bash "$GATE"
  [ "$status" -eq 2 ]
  [[ "$output" != *"changed="* ]]
}

@test "size gate: an unknown flag is a usage error" {
  fixture "$(printf '1\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate --bogus
  [ "$status" -eq 2 ]
  [[ "$output" != *"changed="* ]]
}

@test "size gate: an unknown --format value is a usage error" {
  fixture "$(printf '1\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate --format yaml
  [ "$status" -eq 2 ]
}

@test "size gate: a missing diff file is an input error" {
  NS="$TMPDIR_HELPER/numstat.txt"
  printf '1\t0\tsrc/a.ts\n' > "$NS"
  run bash "$GATE" --numstat-file "$NS" --diff-file "$TMPDIR_HELPER/nope.diff"
  [ "$status" -eq 2 ]
}

@test "size gate: text output carries exactly one line per key" {
  fixture "$(printf '10\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate
  [ "$status" -eq 0 ]
  exactly_one changed
  exactly_one tier
  exactly_one automerge
  exactly_one override
  exactly_one excluded
}

@test "size gate: JSON output carries the same keys" {
  fixture "$(printf '10\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate --format json
  [ "$status" -eq 0 ]
  [[ "$output" == *'"changed":10'* ]]
  [[ "$output" == *'"tier":"auto"'* ]]
  [[ "$output" == *'"automerge":true'* ]]
  [[ "$output" == *'"excluded":0'* ]]
}

@test "size gate: identical inputs produce byte-identical output" {
  fixture "$(printf '5\t5\tsrc/a.ts\n1\t0\tsrc/b.ts')" "$MODIFIED_DIFF"
  local first second
  first="$(bash "$GATE" --numstat-file "$NS" --diff-file "$DF")"
  second="$(bash "$GATE" --numstat-file "$NS" --diff-file "$DF")"
  [ "$first" = "$second" ]
}

@test "size gate: a rename destination inside generated/ is excluded" {
  fixture "$(printf '50\t0\tsrc/{old => generated}/client.ts')" "$MODIFIED_DIFF"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"changed=0"* ]]
  [[ "$output" == *"excluded=1"* ]]
}

@test "size gate: a plain rename path counts once using its destination" {
  fixture "$(printf '6\t4\told/name.ts => new/name.ts')" "$MODIFIED_DIFF"
  gate
  [ "$status" -eq 0 ]
  [[ "$output" == *"changed=10"* ]]
  [[ "$output" == *"excluded=0"* ]]
}

@test "size gate: a team handle never authorizes the override" {
  CO="$TMPDIR_HELPER/CODEOWNERS"
  printf '* @acme/leads\n' > "$CO"
  fixture "$(printf '500\t0\tsrc/a.ts')" "$MODIFIED_DIFF"
  gate --label present --label-actor alice --codeowners "$CO"
  [ "$status" -eq 1 ]
  [[ "$output" == *"override=unauthorized"* ]]
}

@test "size gate: --base/--head computes the same count as explicit files" {
  local repo="$TMPDIR_HELPER/git"
  mkdir -p "$repo"
  git -C "$repo" init -q
  git -C "$repo" -c user.email=t@t -c user.name=t commit -q --allow-empty -m one
  local base
  base="$(git -C "$repo" rev-parse HEAD)"
  printf 'one\ntwo\n' > "$repo/f.txt"
  git -C "$repo" add f.txt
  git -C "$repo" -c user.email=t@t -c user.name=t commit -q -m two
  local head
  head="$(git -C "$repo" rev-parse HEAD)"
  run bash -c "cd '$repo' && bash '$GATE' --base '$base' --head '$head'"
  [ "$status" -eq 0 ]
  [[ "$output" == *"changed=2"* ]]
}
