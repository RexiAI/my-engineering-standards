node_modules/
dist/
build/
target/
bin/
reports/
.idea/
.vscode/
*.iml
.DS_Store
*.swp
*.swo
*~
.env
.env.local

# Spec 042: every dotenv variant is local state, not just .env / .env.local.
# The committed templates stay trackable — config/model.local.env.example,
# config/agent.local.env.example, and templates/.envrc.example do not match
# this pattern, and .envrc keeps its own entry below.
.env.*
.serena/

# Per-machine model overrides for the spec pipeline (see docs/SPEC_PIPELINE.md
# §Model configuration). The committed template config/model.local.env.example
# stays trackable; the real file must never be committed.
config/model.local.env

# Per-machine agent credentials (spec 013): the committed template
# config/agent.local.env.example stays trackable; the real file must never be
# committed (scripts/guard-env.sh + self-ci enforce).
config/agent.local.env

# Per-machine direnv file (spec 025): the repo-root .envrc is a per-machine
# copy of templates/.envrc.example — gitignored, never committed. The
# committed templates (templates/.envrc.example, templates/.envrc.child) stay
# trackable.
.envrc

# Local cache for machine-generated, never-committed state (spec 028: the
# typed-judgment daily counter files .cache/judgment-cap-YYYY-MM-DD; spec 029:
# the local judgment backend run state — PID files and logs — in
# .cache/judgment/).
.cache/
.cache/judgment/

# Spec 042: rb_* are gate-run capture dumps (the raw stdout of a gate script,
# kept while dogfooding record-gate-run.sh), not source — untracked and
# ignored. runs.jsonl is deliberately NOT covered: it is the long-lived gate-run telemetry ledger written by scripts/record-gate-run.sh and stays tracked.
rb_*

# Local dogfooding scaffold — this repo's own agent/ and command/ symlinked in
# for testing the spec pipeline against itself (docs/SPEC_PIPELINE.md). Child
# repos get the real thing via scripts/bootstrap.sh pointing at .standards/.
.opencode/