        <mxCell id="fail" value="On step N failure: orchestrator runs C(N-1) → C(N-2) → … → C(1) in reverse." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="1120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="store" value="State store: SAGA_STATE row per saga instance&#10;{ saga_id, current_step, status, payload, version, last_updated_at }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=2;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="props" value="+ single place to query "where is order #12345"&#10;+ cross-cutting concerns (timeouts, retries, monitoring) live in one service&#10;+ explicit failure handling — each compensation is named and testable&#10;− orchestrator is a single point of scaling concern&#10;− couples the saga to its own codebase (step types and compensation handlers must be registered)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;spacingTop=5" vertex="1" parent="1">
          <mxGeometry x="620" y="380" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="CI Quality Gate — ci/templates/archunit/SagaArchRules.java enforces: every SagaHandler must declare a compensation function; SagaHandler methods must be @Transactional; orchestrators must use persistent state store; sagas must not call broker directly; sagas must not depend on controllers. See scripts/check-saga-timeouts.sh and check-saga-tests.sh." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="1120" height="50" as="geometry" />
        </mxCell>
