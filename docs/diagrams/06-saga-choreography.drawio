  <diagram name="Saga-Choreography" id="saga-choreo-1">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Saga — choreography (event-driven, no central orchestrator)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="order_svc" value="Order Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="payment_svc" value="Payment Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="inventory_svc" value="Inventory Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="580" y="100" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="shipping_svc" value="Shipping Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="840" y="100" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bus" value="Event bus (Kafka / SNS / EventBridge) — durable, ordered per partition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="920" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="OrderCreated" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;" edge="1" parent="1" source="order_svc" target="bus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="OrderCreated" style="endArrow=classic;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="bus" target="payment_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="PaymentAuthorized" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="payment_svc" target="bus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="PaymentAuthorized" style="endArrow=classic;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="bus" target="inventory_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="InventoryReserved" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="inventory_svc" target="bus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="InventoryReserved" style="endArrow=classic;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="bus" target="shipping_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="OrderShipped" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="shipping_svc" target="bus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="FAILURE PATH — InventoryRejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="540" y="320" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="PaymentRefunded (compensate)" style="endArrow=classic;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#b85450;dashed=1;strokeWidth=2;" edge="1" parent="1" source="fail" target="payment_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="OrderCancelled (compensate)" style="endArrow=classic;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#b85450;dashed=1;strokeWidth=2;" edge="1" parent="1" source="fail" target="order_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="props" value="Each step is a consumer of the previous event. Each step publishes its own event on success or its compensation event on failure. No central state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="props2" value="+ simple to start, no orchestrator to deploy&#10;+ each service owns its own business logic&#10;− no global view of saga state — hard to debug "where is order #12345?"&#10;− easy to get cyclic event dependencies at scale&#10;− harder to add cross-cutting concerns (timeouts, retries, monitoring) consistently" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=10;spacingTop=5" vertex="1" parent="1">
          <mxGeometry x="480" y="410" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="timeout" value="Every handler MUST have a timeout (Java: @Timeout / TimeLimiterConfig; Go: context.WithTimeout; Node: sagaStep({ timeout })). See scripts/check-saga-timeouts.sh." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="920" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
