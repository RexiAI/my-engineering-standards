          <mxGeometry x="340" y="80" width="140" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="lane_ux" value="STAGE 1.5&#10;spec-ux" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=center;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="120" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="lane_coder" value="STAGE 2&#10;spec-coder" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=center;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="120" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="lane_refactorer" value="STAGE 3&#10;spec-refactorer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=center;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="120" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="lane_verifier" value="STAGE 4&#10;spec-verifier" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;align=center;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="920" y="80" width="120" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="lane_architect" value="STAGE 5a/5b&#10;mutation-runner + pr-opener" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;align=center;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1060" y="80" width="100" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="step0" value="Stage 0: write 00-informal.md&#10;(loose prose, your words)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="50" y="160" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="run /spec &lt;slug&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="190" y="240" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="delegate to spec-specifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="350" y="240" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="read 00-informal.md&#10;write 10-tasks.md&#10;write 20-acceptance/AC-NNN-*.md&#10;(Given/When/Then, stable IDs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="340" y="310" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="delegate to spec-ux" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="500" y="430" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step5" value="loads design-taste-frontend skill&#10;if frontend surface: write 15-design.md&#10;else: SKIPPED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="490" y="500" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="HUMAN GATE — STOP&#10;review 10-tasks.md,&#10;20-acceptance/, 15-design.md&#10;fix or approve, then /build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step6" value="run /build &lt;slug&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="190" y="740" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step7" value="delegate to spec-coder&#10;(DENIED: 00-informal.md)&#10;1) acceptance tests from scenarios&#10;2) unit tests for boundary/error&#10;3) min implementation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="650" y="740" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step8" value="delegate to spec-refactorer&#10;(DENIED: all specs/**)&#10;1) complexity ≤6&#10;2) dedup&#10;3) property tests (prod+)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="790" y="740" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step9" value="delegate to spec-verifier&#10;(DENIED: 00-informal.md,&#10;git commit/push)&#10;re-runs ALL prior claims&#10;writes 25-verification.md&#10;verdict: PASS / FAIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="930" y="740" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="Verdict?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="930" y="880" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="STOP — fail block,&#10;relay 25-verification.md&#10;(Verifier cannot fix)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="step10" value="delegate to spec-mutation-runner (5a),&#10;then spec-pr-opener (5b)&#10;(DENIED: 00-informal.md)&#10;1) mutation ≥80% (prod+)&#10;2) full suite green&#10;3) commits per task + push&#10;4) open DRAFT PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1060" y="970" width="100" height="130" as="geometry" />
        </mxCell>
        <mxCell id="end" value="DRAFT PR&#10;human reviews" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="200" height="60" as="geometry" />
