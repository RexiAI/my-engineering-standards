          <mxGeometry x="40" y="80" width="120" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="lane_orc" value="ORCHESTRATOR&#10;spec-pipeline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=center;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="180" y="80" width="140" height="1180" as="geometry" />
        </mxCell>
