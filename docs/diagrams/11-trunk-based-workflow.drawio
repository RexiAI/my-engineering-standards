          <mxGeometry x="320" y="240" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="CI: test → lint → contract → integration → security → docker&#10;branch protection: 1+ reviewer (prod+), 0 (mvp self-merge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="320" y="330" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="review" value="review (≥1 other for prod+)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="560" y="240" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="merge" value="squash-merge to main&#10;(only merge strategy allowed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="560" y="330" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="delete" value="source branch auto-deleted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="560" y="410" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="semrel" value="semantic-release on push to main:&#10;1. read commits since last tag&#10;2. compute next version:&#10;    feat → 0.X.0  |  fix → 0.0.X&#10;    feat! / BREAKING → X.0.0&#10;    chore/docs/test/refactor → no release&#10;3. create annotated tag vX.Y.Z on main&#10;4. publish GitHub release with changelog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="780" y="240" width="280" height="160" as="geometry" />
