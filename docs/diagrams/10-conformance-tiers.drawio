        <mxCell id="cadence" value="Tier promotion path: mvp → production (when you add 2nd service, real users, or PII) → multi-service (when you have >1 service with cross-service workflows). Each tier adds the gates you didn't need before, never removes them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=10" vertex="1" parent="1">
