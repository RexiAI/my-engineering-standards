        <mxCell id="versioning" value="Versioning: tags created by CI on main only. feat → minor, fix → patch, BREAKING CHANGE footer / feat! → major. chore/docs/test/refactor → no release. Never create tags manually." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=10" vertex="1" parent="1">
