<mxfile host="app.diagrams.net" modified="2024-01-01T00:00:00.000Z" agent="opencode-doc-gen" version="24.0.0" type="device">
  <diagram name="Layered-Architecture" id="layered-1">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Layered architecture — strict downward dependency direction" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="controller" value="CONTROLLER (HTTP handlers)&#10;• parse and validate input&#10;• call service methods&#10;• return HTTP responses&#10;• NEVER contains business logic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="service" value="SERVICE (business logic)&#10;• orchestrate business operations&#10;• coordinate across multiple repositories / external clients&#10;• apply domain logic and validation rules&#10;• emit events / logs at method boundaries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="300" y="240" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="repository" value="REPOSITORY (data access)&#10;• abstract data access (DB, cache, external API)&#10;• map between domain objects and persistence/DTO models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="300" y="380" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="external" value="EXTERNAL (database, cache, upstream services)&#10;• PostgreSQL, Redis, DynamoDB, S3, SQS, Kafka, third-party HTTP APIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="300" y="490" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule" value="✓ Layers may only depend on the layer directly below.&#10;✗ Controllers NEVER access repositories directly — they call services, which call repositories.&#10;✗ Repositories never know about HTTP, sessions, or request scope.&#10;✗ External clients (DB, cache, message bus) only ever called from the repository layer (or the service layer for outbox-relay / saga orchestrator)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="obs" value="Observability per layer:&#10;• Controller — trace inbound request, HTTP metrics&#10;• Service — trace business logic, log method boundaries with trace ID&#10;• Repository — trace queries, DB latency metrics&#10;• External — trace downstream calls, circuit breaker state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="resilience" value="Resilience at every external boundary:&#10;• Transient failures → retry+backoff&#10;• Cascading failures → circuit breaker&#10;• Resource exhaustion → bulkhead, timeout&#10;• Duplicate requests → idempotency key&#10;• Reliable publishing → transactional outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6c8ebf;strokeWidth=3;" edge="1" parent="1" source="controller" target="service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#82b366;strokeWidth=3;" edge="1" parent="1" source="service" target="repository">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666;strokeWidth=3;" edge="1" parent="1" source="repository" target="external">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="health" value="Every service exposes /health that aggregates deep checks of every external dependency (DB, cache, messaging, KMS)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="560" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
